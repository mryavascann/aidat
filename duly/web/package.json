    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.63.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.2",
    "vite": "8.3.0"
  },
  "overrides": {
    "@near-js/utils": "1.1.0"
  }
