    "test:live": "node tests/building.mjs --live",
    "format": "prettier --write src tests vite.config.ts",
    "test:passkey": "node tests/passkey.mjs",
    "test:queue": "node tests/queue.mjs",
    "serve": "node server/local.mjs",
    "test:legacy:a11y": "node tests/a11y.mjs",
    "test:legacy:theme": "node tests/theme.mjs",
    "test:legacy:recovery": "node tests/recovery.mjs",
    "test:legacy:wallet": "node tests/wallet.mjs"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "2.6.0",
    "@duly/accounts": "file:accounts",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@stellar/stellar-sdk": "16.3.0",
    "buffer": "^6.0.3",
    "lucide-react": "1.47.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@duly/stellar-sdk": "npm:@stellar/stellar-sdk@17.1.0"
  },
  "devDependencies": {
